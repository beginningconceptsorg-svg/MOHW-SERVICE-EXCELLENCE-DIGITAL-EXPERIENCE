{
  "name": "bc-central-ai",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-27",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BUDGET",
        "class_name": "DailyBudget"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DailyBudget"
      ]
    }
  ],
  "observability": {
    "enabled": false
  }
}
